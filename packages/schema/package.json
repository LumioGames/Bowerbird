{
  "name": "@bowerbird/schema",
  "version": "0.1.0",
  "description": "Bowerbird data structures: .bmeta, library.json, query model, HTTP API requests/responses, events, plugin manifest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LumioGames/Bowerbird.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/LumioGames/Bowerbird#readme",
  "bugs": {
    "url": "https://github.com/LumioGames/Bowerbird/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "default": "./dist/locale.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
