# Workflow 本地草稿（任务真值在线上，草稿不入库）
.workflow-drafts/

# 系统文件
.DS_Store
.preview/

# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo
coverage/

# 测试产物
test-results/
playwright-report/
e2e/.artifacts/
.tmp/
fixtures/perf-100k/
# Sample libraries for tests: generated by scripts/ensure-fixtures.mjs (pnpm fixtures), not kept in the repository.
fixtures/xingluo/
fixtures/upload-batch/
fixtures/.generated.json

# Copied from the repository root at pack time (scripts/copy-legal.mjs); the root files are the only source.
packages/*/LICENSE
packages/*/THIRD_PARTY_NOTICES.md
# …except the MIT packages that plugins are built with, whose own LICENSE is the source (ADR-059).
!packages/schema/LICENSE
!packages/plugin-sdk/LICENSE
!packages/plugin-build/LICENSE
