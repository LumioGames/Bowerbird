  "description": "Bowerbird — a web-based game asset manager: server, web shell, command line (bb), MCP and the six built-in plugins",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LumioGames/Bowerbird.git",
    "directory": "packages/bowerbird"
  },
  "homepage": "https://github.com/LumioGames/Bowerbird#readme",
  "bugs": {
    "url": "https://github.com/LumioGames/Bowerbird/issues"
  },
