{
  "name": "@bowerbird-fixtures/plugin-forge",
  "version": "0.4.0",
  "private": true,
  "description": "Test-only third-party creator plugin (fake AI generation) that exercises every UI slot. Not published.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "tsc -b && bowerbird-plugin-build",
    "typecheck": "tsc -b"
  },
  "bowerbird": {
    "id": "community.forge",
    "displayName": "Forge",
    "description": "AI 生图与生成模型（测试用，假实现，不访问网络）",
    "apiVersion": 1,
    "server": "./dist/server.js",
    "web": "./dist/web.js",
    "contributes": {
      "creators": [
        {
          "id": "image"
        },
        {
          "id": "model"
        }
      ],
      "actions": [
        {
          "id": "variant"
        }
      ],
      "ui": {
        "detailTabs": [
          "forge"
        ],
        "toolbarItems": [
          "forge-quota"
        ],
        "sidebarSections": [
          "forge-runs"
        ],
        "pages": [
          "pick"
        ],
        "settingsPages": [
          "forge"
        ]
      },
      "settings": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "title": "服务地址",
            "scope": "library",
            "default": "https://api.forge.example/v1"
          },
          "defaultModel": {
            "type": "string",
            "title": "默认模型",
            "scope": "library",
            "enum": [
              "forge-xl 2.1",
              "forge-lite 1.3"
            ],
            "default": "forge-xl 2.1"
          },
          "outputFolder": {
            "type": "string",
            "title": "产出放到",
            "scope": "library",
            "default": ""
          },
          "apiKey": {
            "type": "string",
            "title": "访问密钥",
            "scope": "machine",
            "writeOnly": true
          },
          "simulate": {
            "type": "string",
            "title": "测试：模拟故障",
            "scope": "machine",
            "enum": [
              "none",
              "missing-tool",
              "unavailable"
            ],
            "default": "none",
            "enumNames": [
              "不模拟",
              "缺少外部工具",
              "服务没有响应（503）"
            ]
          }
        }
      }
    },
    "requires": {
      "tools": []
    },
    "l10n": {
      "en": {
        "Forge": "Forge",
        "AI 生图与生成模型（测试用，假实现，不访问网络）": "AI images and models (for tests: fake, no network access)",
