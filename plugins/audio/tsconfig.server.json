{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.server.tsbuildinfo",
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/web",
    "src/**/*.test.ts",
    "src/**/__tests__"
  ],
  "references": [
    {
      "path": "../../packages/schema"
    },
    {
      "path": "../../packages/plugin-sdk/tsconfig.server.json"
    }
  ]
}
